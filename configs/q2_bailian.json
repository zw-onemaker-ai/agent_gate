{
  "meta": {
    "project": "Todo_API_Bailian",
    "version": "1.2",
    "description": "百炼token-plan计划(计划专属域名) — 运行时清单核验过的现役模型注册表"
  },
  "providers": {
    "litellm": {
      "base_url": "https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1",
      "api_key": "${DASHSCOPE_API_KEY}"
    }
  },
  "models": {
    "default": "qwen3.7-plus",
    "registry": {
      "qwen3.6-flash": {
        "provider": "litellm",
        "model": "qwen3.6-flash"
      },
      "qwen3.7-plus": {
        "provider": "litellm",
        "model": "qwen3.7-plus"
      },
      "qwen3.7-max": {
        "provider": "litellm",
        "model": "qwen3.7-max"
      },
      "qwen3.8-max": {
        "provider": "litellm",
        "model": "qwen3.8-max"
      },
      "deepseek-v4-pro": {
        "provider": "litellm",
        "model": "deepseek-v4-pro"
      },
      "deepseek-v4-flash": {
        "provider": "litellm",
        "model": "deepseek-v4-flash-0731"
      },
      "glm-5.2": {
        "provider": "litellm",
        "model": "glm-5.2"
      }
    },
    "strategy": {
      "mode": "cost_aware",
      "rules": [
        {
          "role_pattern": "R[1-3]",
          "model": "qwen3.6-flash",
          "reason": "需求/设计/架构 — 便宜够用"
        },
        {
          "role_pattern": "R[4-5]",
          "model": "qwen3.7-max",
          "reason": "后端/前端 — 代码质量优先"
        },
        {
          "role_pattern": "R[6-8]",
          "model": "qwen3.7-plus",
          "reason": "安全/测试/DevOps — 平衡"
        },
        {
          "role_pattern": "R[9-10]",
          "model": "qwen3.6-flash",
          "reason": "文档/审查 — 轻量即可"
        }
      ]
    }
  },
  "agents": [
    {
      "role": "R1",
      "name": "需求分析",
      "model": "qwen3.6-flash",
      "role_goal": "分析用户需求，产出 requirements.md，含3+用户故事和验收标准",
      "output_file": "requirements.md",
      "acceptance_criteria": [
        "含至少3个用户故事",
        "每个故事含验收标准"
      ],
      "scenario_type": "code_gen",
      "declared_tools": [
        "@web_search",
        "@read_file"
      ]
    },
    {
      "role": "R2",
      "name": "产品设计",
      "model": "qwen3.6-flash",
      "role_goal": "基于需求产出产品规格说明书，定义MVP功能和优先级",
      "output_file": "product_spec.md",
      "acceptance_criteria": [
        "含功能清单与优先级标注",
        "MVP范围明确定义"
      ],
      "scenario_type": "code_gen",
      "declared_tools": [
        "@read_file"
      ]
    },
    {
      "role": "R4",
      "name": "后端开发",
      "model": "qwen3.7-max",
      "role_goal": "开发FastAPI Todo后端，含CRUD端点和健康检查",
      "output_file": "backend/main.py",
      "acceptance_criteria": [
        "GET /todos 返回200",
        "POST /todos 创建并返回201"
      ],
      "scenario_type": "code_gen",
      "declared_tools": [
        "@write_file",
        "@run_bash"
      ]
    }
  ],
  "topology": {
    "stages": [
      {
        "stage": 1,
        "agents": [
          "R1"
        ],
        "mode": "serial",
        "max_retries": 3
      },
      {
        "stage": 2,
        "agents": [
          "R2"
        ],
        "mode": "serial",
        "max_retries": 3,
        "on_fail": "R1"
      },
      {
        "stage": 3,
        "agents": [
          "R4"
        ],
        "mode": "serial",
        "max_retries": 3,
        "on_fail": "R2"
      }
    ]
  },
  "context": {
    "routes": [
      {
        "from": "R1",
        "to": "R2",
        "files": [
          "requirements.md"
        ]
      },
      {
        "from": "R2",
        "to": "R4",
        "files": [
          "product_spec.md",
          "requirements.md"
        ]
      }
    ]
  },
  "design_notes": {
    "why_these_agents": "3-agent串行管线。注册表来自2026-08-14运行时核验的真实清单(token-plan计划): qwen3.6-flash/3.7-plus/3.7-max/3.8-max + glm-5.2 + deepseek-v4系列。设计脑(strong档)→qwen3.8-max; 代码角色→qwen3.7-max; 轻量→qwen3.6-flash",
    "gaps_found": [
      "缺少前端(R5)"
    ],
    "risks": [
      "token-plan计划QPS限制可能影响并行场景",
      "按角色分模型需engine接线后才生效(known: per_agent_model_not_wired)"
    ]
  }
}